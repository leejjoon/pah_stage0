Bootstrap: docker
From: ubuntu:24.04
# Container C for x86-64 (Intel or AMD), CPU-only: the same tools as C_cpu.def, pinned to the GH200 build.
# Build ON an x86-64 machine, from the repository root (the %files paths are relative to it):
#   apptainer build --fakeroot C_cpu_x86.sif containers/C_cpu_x86.def
# Test it there with containers/tests/run_c.sh C_cpu_x86.sif
#
# What differs from C_cpu.def (aarch64):
# - Python packages come from containers/C_cpu_lock/requirements-pypi.txt, the list frozen inside C_cpu.sif, so
#   versions match the GH200 image. PAHFIT and the PAHdb suite come from the same git commits as before.
# - Python is uv's CPython 3.12.14 (same as the GH200 image). juliacall ties OpenSSL_jll to Python's OpenSSL,
#   and the locked Manifest has OpenSSL_jll 3.5.8, which matches it.
# - Julia is pinned to 1.13.3 and its packages to containers/C_cpu_lock/Manifest.toml (copied from C_cpu.sif).
#   juliapkg deletes any Manifest when it resolves, so the locked one is put in place afterwards and instantiated.
# - JULIA_CPU_TARGET compiles the Julia package images for several x86 CPU generations (the list Julia's own
#   x86-64 binaries use), so they load on any recent Intel or AMD CPU without recompiling on first use.
%files
  containers/C_cpu_lock /opt/lock
%post
  set -e
  [ "$(uname -m)" = x86_64 ] || { echo "C_cpu_x86.def must be built on an x86-64 machine (this is $(uname -m))"; exit 1; }
  export DEBIAN_FRONTEND=noninteractive
  apt-get update && apt-get install -y git ca-certificates curl
  curl -LsSf https://astral.sh/uv/0.12.12/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
  export UV_PYTHON_INSTALL_DIR=/opt/python
  uv python install 3.12.14
  uv venv --seed -p 3.12.14 /opt/venv && . /opt/venv/bin/activate
  python -c "import ssl, sys; print(sys.version, ssl.OPENSSL_VERSION)"

  # Python packages: exactly the GH200 versions
  python -m pip install -r /opt/lock/requirements-pypi.txt
  python -m pip install --no-deps "git+https://github.com/PAHFIT/pahfit.git@ca599f9a1eb57a9ed3305651e77fcc9d8e039333"
  python -m pip install --no-deps "git+https://github.com/PAHdb/AmesPAHdbPythonSuite.git@e8961b2bf8b0ae663663a6790d452e1fe9fd1bd3"
  python -m pip check
  python -m pip list --format=freeze > /opt/requirements-frozen.txt
  # every pin must have landed (git packages compared by name only)
  python - <<'EOF'
want = {l.split("==")[0].lower(): l.split("==")[1] for l in open("/opt/lock/requirements-pypi.txt") if "==" in l and not l.startswith("#")}
have = {l.split("==")[0].lower(): l.split("==")[1].strip() for l in open("/opt/requirements-frozen.txt") if "==" in l}
bad = {k: (v, have.get(k)) for k, v in want.items() if have.get(k) != v.strip()}
assert not bad, f"pip versions differ from the lock: {bad}"
assert "pahfit" in have and "amespahdbpythonsuite" in have
print("pip versions match the lock:", len(want), "packages")
EOF

  # Julia: pin 1.13.3, let juliapkg install it and write its metadata, then swap in the locked Manifest
  export JULIA_DEPOT_PATH=/opt/julia_depot PYTHON_JULIAPKG_PROJECT=/opt/julia_env
  export JULIA_CPU_TARGET="generic;sandybridge,-xsaveopt,clone_all;haswell,-rdrnd,base(1);x86-64-v4,-rdrnd,base(1)"
  python -c "import juliapkg; juliapkg.require_julia('=1.13.3'); juliapkg.resolve()"
  JL=$(python -c "import json; print(json.load(open('/opt/julia_env/pyjuliapkg/meta.json'))['executable'])")
  python -c "import tomllib as t; a, b = (t.load(open(f, 'rb')) for f in ('/opt/lock/Project.toml', '/opt/julia_env/Project.toml')); assert a == b, (a, b); print('Project.toml matches the lock')"
  cp /opt/lock/Manifest.toml /opt/julia_env/Manifest.toml
  # point PythonCall at the venv's Python, as juliacall does; otherwise CondaPkg installs a second Python
  export JULIA_PYTHONCALL_EXE=/opt/venv/bin/python JULIA_CONDAPKG_BACKEND=Null
  "$JL" --project=/opt/julia_env -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'
  [ ! -e /opt/julia_env/.CondaPkg ] || { echo "CondaPkg created its own Python env"; exit 1; }
  # every package version must match the lock
  "$JL" --project=/opt/julia_env -e '
    using Pkg, TOML
    lock = TOML.parsefile("/opt/lock/Manifest.toml")["deps"]
    bad = String[]
    for (_, p) in Pkg.dependencies()
        haskey(lock, p.name) || continue
        v = get(lock[p.name][1], "version", nothing)
        v === nothing || p.version === nothing || VersionNumber(v) == p.version || push!(bad, "$(p.name) $(p.version) != $v")
    end
    isempty(bad) || error("Julia packages differ from the lock: $bad")
    println("Julia ", VERSION, ": package versions match the lock")'
  # the Python side must now load without resolving again (it runs offline at run time)
  PYTHON_JULIAPKG_OFFLINE=yes python -c "import juliapkg.deps as d; assert d.can_skip_resolve(), 'juliapkg would re-resolve'; import pysr; print('pysr', pysr.__version__)"
  chmod -R a+rX /opt/julia_depot /opt/julia_env /opt/python /opt/lock
  python -c "import json; print('julia', json.load(open('/opt/julia_env/pyjuliapkg/meta.json'))['version'])"
%environment
  export PATH=/opt/venv/bin:$PATH
  export PYTHON_JULIAPKG_PROJECT=/opt/julia_env
  export PYTHON_JULIAPKG_OFFLINE=yes
  export JULIA_DEPOT_PATH=${SCRATCH:-$HOME}/julia_depot:/opt/julia_depot
  export JULIA_CPU_TARGET="generic;sandybridge,-xsaveopt,clone_all;haswell,-rdrnd,base(1);x86-64-v4,-rdrnd,base(1)"
%labels
  project pah-sr T0b container C (x86-64)
