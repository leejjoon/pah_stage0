Bootstrap: docker
From: ubuntu:24.04
# Container C: CPU tools, PySR + PAHFIT + AmesPAHdbPythonSuite (plan Section 3.3).
# Python comes from uv (python-build-standalone), not Ubuntu's python3.12. juliacall pins OpenSSL_jll to the
# Python's OpenSSL: Ubuntu's 3.0 forces Julia 1.11.9, which segfaulted in PySR on the GH200 (2026-11-07);
# uv's CPython links OpenSSL 3.5 and gets Julia 1.13.x, which works. It also ships libpython, which PythonCall needs.
%post
  set -e
  export DEBIAN_FRONTEND=noninteractive
  apt-get update && apt-get install -y git ca-certificates curl
  curl -LsSf https://astral.sh/uv/0.12.12/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
  export UV_PYTHON_INSTALL_DIR=/opt/python
  uv python install 3.12
  uv venv --seed -p 3.12 /opt/venv && . /opt/venv/bin/activate
  python -c "import ssl, sys; print(sys.version, ssl.OPENSSL_VERSION)"
  python -m pip install --upgrade pip
  python -m pip install pysr astropy specutils scikit-learn pandas h5py matplotlib jupyter
  python -m pip install "git+https://github.com/PAHFIT/pahfit.git@ca599f9a1eb57a9ed3305651e77fcc9d8e039333"
  python -m pip install "git+https://github.com/PAHdb/AmesPAHdbPythonSuite.git@e8961b2bf8b0ae663663a6790d452e1fe9fd1bd3"
  export JULIA_DEPOT_PATH=/opt/julia_depot PYTHON_JULIAPKG_PROJECT=/opt/julia_env
  python -c "import pysr"
  chmod -R a+rX /opt/julia_depot /opt/julia_env /opt/python
  python -c "import json; print('julia', json.load(open('/opt/julia_env/pyjuliapkg/meta.json'))['version'])"
  python -m pip check
  python -m pip list --format=freeze > /opt/requirements-frozen.txt
%environment
  export PATH=/opt/venv/bin:$PATH
  export PYTHON_JULIAPKG_PROJECT=/opt/julia_env
  export PYTHON_JULIAPKG_OFFLINE=yes
  export JULIA_DEPOT_PATH=${SCRATCH:-$HOME}/julia_depot:/opt/julia_depot
%labels
  project pah-sr T0b container C
